# i3status configuration file.
# see "man i3status" for documentation.

# It is important that this file is edited as UTF-8.
# The following line should contain a sharp s:
# ß
# If the above line is not correctly displayed, fix your editor first!

general {
  interval = 5
  colors = true
  color_good = "#50FA7B"
  color_degraded = "#FF8723"
  color_bad = "#FF5555"
  markup = pango
}

order += "tztime local_date"
order += "tztime local_time"
order += "tztime nuremberg_time"
order += "cpu_usage"
order += "memory"
order += "battery all"
order += "volume master"
order += "ethernet _first_"
order += "wireless _first_"

tztime local_date {
  format = "<span foreground='#627CC2'>&#xf00f5;</span> %F" # nf-md-calendar_text symbol
}

tztime local_time {
  format = "<span foreground='#627CC2'>&#xf017;</span> %R %z" # nf-fa-clock symbol
}

tztime nuremberg_time {
  format_time = "%R %z"
  format = "<span foreground='#627CC2'>&#xeb01;</span> NUE %time" # nf-cod-globe symbol
  locale = "de_DE.UTF-8"
  timezone = "Europe/Berlin"
  hide_if_equals_localtime = true
}

cpu_usage {
  format = "<span foreground='#627CC2'>&#xf463;</span> %usage" # nf-oct-meter symbol
  max_threshold = "50"
  degraded_threshold = "30"
}

memory {
  format = "<span foreground='#627CC2'>&#xf035b;</span> %used" # nf-md-memory symbol
  threshold_degraded = "10%"
}

battery all {
  integer_battery_capacity = true
  format = "%status %percentage"
  format_down = ""
  status_chr = "<span foreground='#627CC2'>&#xf089d;</span>"  # nf-md-battery_charging_50 symbol
  status_bat = "<span foreground='#F1FA8C'>&#xf007e;</span>"  # nf-md-battery_50 symbol
  status_full = "<span foreground='#50FA7B'>&#xf0079;</span>" # nf-md-battery symbol
  status_unk = "<span foreground='#FF5555'>&#xf0091;</span>"  # nf-md-battery_unknown symbol
  low_threshold = "15"
  threshold_type = "time"
}

volume master {
  format = "<span foreground='#627CC2'>&#xf057e;</span> %volume" # nf-md-volume_high symbol
  format_muted = "&#xf0581; 0%%"                                 # nf-md-volume_off symbol
  device = "default"
  mixer = "Master"
  mixer_idx = 0
}

ethernet _first_ {
  format_up = "&#xf0318; <span foreground='#BFBFBF'>up</span>"   # nf-md-lan_connect symbol
  format_down = "&#xf0319; <span foreground='#BFBFBF'>dw</span>" # nf-md-lan_disconnect symbol
}

wireless _first_ {
  format_up = "&#xf05a9; <span foreground='#BFBFBF'>up</span>"   # nf-md-wifi symbol
  format_down = "&#xf05aa; <span foreground='#BFBFBF'>dw</span>" # nf-md-wifi_off symbol
}
