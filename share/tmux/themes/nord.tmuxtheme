# Inspired by nord theme for tmux
# https://github.com/arcticicestudio/nord-tmux/

# Status bar
set-option -g status-justify center

# Basic status bar colors
set-option -g status-style bg=black,fg=white

# Left side of status bar
set-option -g status-left-style bg=blue,fg=black,bold
set -gs @sl_sep '#[bg=black,fg=blue,none]'

set-option -g status-left ' #S #{@sl_sep}'

# Right side of status bar
set-option -g status-right-style bg=cyan,fg=brightblack,bold
set -gs @sr_sep '#[bg=black,fg=cyan]#[default]'

set-option -g status-right '#{@sr_sep} %H:%M '

# Window status
set-option -gw window-status-style bg=default,fg=white
set-option -gw window-status-bell-style bg=magenta,fg=white

set-option -gw window-status-format '  #I #W   '

# Window status current
set-option -gw window-status-current-style bg=brightblack,fg=white,bold

set -gs @wsc_in  '#[bg=black,fg=brightblack]#[default]'
set -gs @wsc_out '#[bg=black,fg=brightblack]'

set-option -gw window-status-current-format '#{@wsc_in} #I #W #{@wsc_out} '

# Pane border
set-option -g pane-border-style bg=default,fg=brightblack

# Active pane border
set-option -g pane-active-border-style bg=default,fg=blue

# Pane number indicator
set-option -g display-panes-colour black
set-option -g display-panes-active-colour brightblack

# Clock mode
set-option -g clock-mode-colour cyan

# Message
set-option -g message-style bg=brightblack,fg=cyan

# Command message
set-option -g message-command-style bg=brightblack,fg=cyan

# Mode
set-option -g mode-style bg=brightblack,fg=cyan
